# ──────────────────────────────────────────────────────────────────────────────
# Sales Order Management — Oracle Database Connection
# ──────────────────────────────────────────────────────────────────────────────

# Oracle DB credentials (shared by account and group queries)
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password

# Oracle connection URL.
# Accepted formats:
#   EZConnect:  hostname:1521/SERVICE_NAME
#   JDBC thick: jdbc:oracle:thin:@hostname:1521:SID
#   JDBC thin:  jdbc:oracle:thin:@//hostname:1521/SERVICE_NAME
DB_URL=hostname:1521/SERVICE_NAME

# JDBC driver class — informational only (not used by the oracledb Python driver)
DB_DRIVER_CLASS=oracle.jdbc.OracleDriver

# Optional additional oracledb connection parameters (JSON object).
# See https://python-oracledb.readthedocs.io/en/latest/api_manual/module.html#oracledb.connect
# Example: {"tcp_connect_timeout": 5, "retry_count": 3}
# DB_EXTRA_PARAMS=

# ──────────────────────────────────────────────────────────────────────────────
# Veza Configuration
# ──────────────────────────────────────────────────────────────────────────────
VEZA_URL=https://your-company.veza.com
VEZA_API_KEY=your_veza_api_key_here

# ──────────────────────────────────────────────────────────────────────────────
# OAA Provider Settings (optional overrides)
# ──────────────────────────────────────────────────────────────────────────────
# PROVIDER_NAME=Sales Order Management
# DATASOURCE_NAME=SOM
